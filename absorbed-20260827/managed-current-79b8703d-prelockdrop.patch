+            "provider": "openai-codex",
+            "usage": {"total": 1_900_000, "context_max": 272_000},
+        },
+        "_metadata_message_count": 0,
+    }
+    monkeypatch.setattr(server, "_get_db", lambda: None)
+    out = server._format_live_context_output(session)
+    # Fail closed: the cumulative total must never surface as current context,
+    # and with occupancy unknown no "Context usage:" line is emitted at all.
+    assert "1,900,000" not in out
+    assert "Context usage" not in out
+

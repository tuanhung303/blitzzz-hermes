+    assert "possible stall" in metadata["progress_advice"].lower()
+
+
+def test_runtime_metadata_accepts_observable_batch_progress():
+    metadata = runtime_metadata(901, progress_observed=True)
+
+    assert metadata["progress_observed"] is True
+    assert "continue monitoring" in metadata["progress_advice"].lower()
+
+
+def test_background_poll_returns_runtime_advice_and_progress_signal():

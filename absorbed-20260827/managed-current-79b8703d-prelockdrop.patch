+def test_format_live_context_does_not_substitute_cumulative_total(monkeypatch):
+    """The /context read-out must not fall back to the lifetime session total
+    when context_used is absent — that substitutes a cumulative number for the
+    current occupancy and reads as an impossible ~1.9M / 272K on long
+    Codex/OAuth sessions (#50421 class)."""
+    session = {
+        "agent": None,
+        "history": [],
+        "session_key": None,
+        "history_lock": threading.Lock(),
+        "_compute_host_active": True,
+        "_metadata_mirror": {

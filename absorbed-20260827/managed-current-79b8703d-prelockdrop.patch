+"""The execution budget is part of every Hermes system prompt."""
+
+from unittest.mock import MagicMock, patch
+
+from agent.prompt_builder import INTERACTIVE_EXECUTION_BUDGET_GUIDANCE
+from run_agent import AIAgent
+
+
+def _tool_defs(*names: str) -> list[dict]:
+    return [
+        {
+            "type": "function",
+            "function": {
+                "name": name,
+                "description": f"{name} tool",
+                "parameters": {"type": "object", "properties": {}},
+            },
+        }
+        for name in names
+    ]
+
+
+def test_budget_guidance_contains_policy_contract():
+    text = INTERACTIVE_EXECUTION_BUDGET_GUIDANCE.lower()
+
+    assert "estimate before execution" in text
+    assert "runtime escalation" in text
+    assert "progress matters" in text
+    assert "3 minutes" in text
+    assert "10 minutes" in text
+    assert "30 minutes" in text
+    assert "synchronously" in text
+
+
+def test_budget_guidance_is_in_global_system_prompt():
+    with (
+        patch("run_agent.get_tool_definitions", return_value=_tool_defs("terminal")),
+        patch("run_agent.check_toolset_requirements", return_value={}),
+        patch("run_agent.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key-1234567890",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+        agent.client = MagicMock()
+
+    assert INTERACTIVE_EXECUTION_BUDGET_GUIDANCE in agent._build_system_prompt()

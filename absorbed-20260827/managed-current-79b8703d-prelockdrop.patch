+def test_get_usage_emits_context_max_when_window_known_but_occupancy_unknown():
+    """The window size is factual metadata — emit it whenever known, even
+    before the first turn (last_prompt_tokens=0/missing) or right after a
+    compression, so the status line always shows a current/total readout.
+    Only the occupancy fields stay gated on a real last_prompt value."""
+    agent = types.SimpleNamespace(
+        model="test-model",
+        session_total_tokens=0,
+        context_compressor=types.SimpleNamespace(
+            last_prompt_tokens=0,
+            context_length=666_000,
+            compression_count=0,
+        ),
+    )
+    usage = server._get_usage(agent)
+    assert usage["context_max"] == 666_000
+    assert "context_used" not in usage
+    assert "context_percent" not in usage
+

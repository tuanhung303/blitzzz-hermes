+import { atom } from 'nanostores'
+
+/**
+ * Status-line water wave pulse state.
+ *
+ * Every `tool.start` gateway event bumps the counter; the status-rule
+ * WaterTicker subscribes and plays exactly one splash pulse per bump.
+ *
+ * Keeping the trigger in its own store decouples the wave from token
+ * throughput: a tool call start overwrites the TPS sample, which used to make
+ * the TPS-driven wave cadence jump mid-call. The wave now answers only to
+ * tool activity, and the TPS meter keeps its own independent readout.
+ */
+export const $wavePulse = atom(0)
+
+/** Signal one tool-call splash (`tool.start`). */
+export const pulseWave = (): void => {
+  $wavePulse.set($wavePulse.get() + 1)
+}

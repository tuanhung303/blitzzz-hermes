+    runtime_advice_for_seconds,
+    runtime_metadata,
+)
+
+
+@pytest.mark.parametrize(
+    ("seconds", "expected_index"),
+    [
+        (0, 0),
+        (59.999, 0),
+        (60, 1),
+        (179.999, 1),
+        (180, 2),
+        (599.999, 2),
+        (600, 3),
+        (1799.999, 3),
+        (1800, 4),

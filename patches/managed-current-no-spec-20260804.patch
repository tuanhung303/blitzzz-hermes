diff --git a/ui-tui/src/lib/sessionExit.ts b/ui-tui/src/lib/sessionExit.ts
new file mode 100644
index 0000000000..29a370f1f9
--- /dev/null
+++ b/ui-tui/src/lib/sessionExit.ts
@@ -0,0 +1,50 @@
+import { writeSync } from 'node:fs'
+
+/**
+ * Print the session id on user-initiated exits (Ctrl+C / Ctrl+D when idle,
+ * /quit) so the user can resume the conversation afterwards. Must run AFTER
+ * the terminal has fully left the alternate screen — the process.on('exit')
+ * handler in entry.tsx resets terminal modes (incl. \x1b[?1049l) and then
+ * flushes the remembered line, so it lands on the restored normal screen and
+ * survives the shell prompt that follows.
+ *
+ * `emit` is injectable for tests; the default writes to fd 1 (stdout).
+ */
+export const emitSessionIdAtExit = (
+  sid: null | string,
+  emit: (text: string) => void = (text: string) => {
+    writeSync(1, text)
+  }
+): void => {
+  if (!sid) {
+    return
+  }
+
+  try {
+    emit(`\nSession ${sid} ended — resume with: hermes --resume ${sid}\n`)
+  } catch {
+    // stdout already gone (dashboard tab closed / EIO) — nothing to show
+  }
+}
+
+/**
+ * die() computes the durable, resumable session id (stored_session_id from
+ * session.info — NOT the gateway-internal 8-hex sid) and remembers it here.
+ * entry.tsx flushes it from the process.on('exit') handler after resetting
+ * terminal modes, guaranteeing the line is the last thing on the terminal
+ * before the shell takes over.
+ */
+let pendingExitSid: null | string = null
+
+export const rememberExitSessionId = (sid: null | string): void => {
+  pendingExitSid = sid
+}
+
+export const flushExitSessionId = (emit?: (text: string) => void): void => {
+  if (pendingExitSid === null) {
+    return
+  }
+
+  emitSessionIdAtExit(pendingExitSid, emit)
+  pendingExitSid = null
+}

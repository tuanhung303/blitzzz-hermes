+    flushExitSessionId(emit)
+    flushExitSessionId(emit)
+
+    expect(emit).toHaveBeenCalledTimes(1)
+    expect(emit).toHaveBeenCalledWith(
+      '\nSession 20260804_113730_2d05f2 ended — resume with: hermes --resume 20260804_113730_2d05f2\n'
+    )
+  })
+
+  it('regression: flush with nothing remembered stays silent', () => {
+    const emit = vi.fn()
+
+    flushExitSessionId(emit)
+
+    expect(emit).not.toHaveBeenCalled()
+  })
+
+  it('regression: a null/empty remember stays silent (no stale id printed on crash paths)', () => {
+    const emit = vi.fn()
+
+    rememberExitSessionId(null)
+    flushExitSessionId(emit)
+
+    expect(emit).not.toHaveBeenCalled()
+  })
+})

@@ -119,6 +119,39 @@
     return value is not False and value != 0
 
 
+ALLOWED_MODELS_SETTING = "allowed_models"
+
+
+def allowed_routes():
+    """The active profile's ``allowed_models`` setting as a set of Hermes route ids, or ``None`` (no limit).
+
+    Each entry may be an alias (``opus``), a canonical id (``claude-opus-5-5``) or a route id
+    (``claude-opus-5-5[1m]``); all resolve through ``native_model`` to the route the picker lists.
+    """
+    value = _setting(ALLOWED_MODELS_SETTING)
+    if isinstance(value, str):
+        value = [part for part in value.replace(",", " ").split()]
+    if not isinstance(value, (list, tuple)):
+        return None
+    routes = set()
+    for item in value:
+        if not isinstance(item, str) or not item.strip():
+            continue
+        try:
+            routes.add(native_model(item.strip()))
+        except ValueError:
+            continue
+    return routes or None
+
+
+def filter_allowed(rows):
+    """Keep only the picker rows (dicts with ``id``, or plain ids) the ``allowed_models`` setting names."""
+    allowed = allowed_routes()
+    if allowed is None or rows is None:
+        return rows
+    return [row for row in rows if (row["id"] if isinstance(row, dict) else row) in allowed]
+
+

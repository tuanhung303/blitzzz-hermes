@@ -0,0 +1,56 @@
+import { atom } from 'nanostores'
+
+import { createTpsTracker, type TpsTracker } from '../lib/tps.js'
+
+import { $uiSessionId } from './uiStore.js'
+
+/**
+ * Status-bar TPS meter state.
+ *
+ * A module-level singleton is enough: the TUI drives one active session at a
+ * time. The tracker resets when ui.sid changes and when a `message.delta` or
+ * `reasoning.delta` arrives for a different session_id. The atom holds the
+ * EMA-smoothed target; the animated readout (TpsMeter in appChrome) eases
+ * toward it so the number rolls evenly instead of snapping between samples.
+ */
+const tracker: TpsTracker = createTpsTracker()
+
+export const $tpsTarget = atom(0)
+
+// Session the current rate belongs to (the last delta's session_id).
+let rateSessionId: null | string = null
+
+/** Reset all measurement state (session switch). */
+export const resetTps = (): void => {
+  tracker.reset()
+  rateSessionId = null
+  $tpsTarget.set(0)
+}
+
+/**
+ * Feed streamed assistant text (chars). A delta for a different session_id
+ * restarts the meter, so the old rate cannot bleed into the new session.
+ * `now` is injectable for tests.
+ */
+export const feedTpsChars = (chars: number, sessionId?: null | string, now: number = Date.now()): void => {
+  if (chars <= 0) {
+    return
+  }
+
+  if ((sessionId ?? null) !== rateSessionId) {
+    resetTps()
+    rateSessionId = sessionId ?? null
+  }
+
+  tracker.sample(chars, now)
+  const value = tracker.read()
+
+  if (value !== $tpsTarget.get()) {
+    $tpsTarget.set(value)
+  }
+}
+
+// /resume, /new or a Ctrl+X switch changes ui.sid before the new session
+// streams anything: drop the old rate at once instead of showing it until the
+// first delta arrives.
+$uiSessionId.listen(() => resetTps())

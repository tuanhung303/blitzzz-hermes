+      onEvent({ payload: { text: 'a streamed chunk of model output. ' }, session_id: sessionId, type } as any)
+    }
+
+    it('feeds the TPS meter from streamed message.delta and reasoning.delta text', () => {
+      vi.useFakeTimers()
+
+      try {
+        for (const type of ['message.delta', 'reasoning.delta']) {
+          resetTps()
+          const onEvent = createGatewayEventHandler(buildCtx([]))
+          patchUiState({ sid: 's1' })
+
+          streamAt(onEvent, type, 's1')
+          expect($tpsTarget.get()).toBe(0)
+          streamAt(onEvent, type, 's1')
+          streamAt(onEvent, type, 's1')
+
+          expect($tpsTarget.get(), type).toBeGreaterThan(0)
+        }
+      } finally {
+        vi.useRealTimers()
+      }
+    })
+
+    it('restarts the TPS meter when deltas arrive for a different session', () => {
+      vi.useFakeTimers()
+
+      try {
+        const onEvent = createGatewayEventHandler(buildCtx([]))
+
+        streamAt(onEvent, 'message.delta', 'a')
+        streamAt(onEvent, 'message.delta', 'a')
+        expect($tpsTarget.get()).toBeGreaterThan(0)
+
+        // The UI switched to session b; its first delta resets the meter so
+        // the old rate cannot bleed in.
+        streamAt(onEvent, 'message.delta', 'b')
+        expect($tpsTarget.get()).toBe(0)
+      } finally {
+        vi.useRealTimers()
+      }
+    })
+
+    it('drops the old rate as soon as ui.sid changes (/resume, /new, Ctrl+X)', () => {
+      vi.useFakeTimers()
+
+      try {
+        const onEvent = createGatewayEventHandler(buildCtx([]))
+        patchUiState({ sid: 'old' })
+
+        streamAt(onEvent, 'message.delta', 'old')
+        streamAt(onEvent, 'message.delta', 'old')
+        expect($tpsTarget.get()).toBeGreaterThan(0)
+
+        // No delta from the new session yet: the switch alone resets it.
+        patchUiState({ sid: 'new' })
+        expect($tpsTarget.get()).toBe(0)
+      } finally {
+        vi.useRealTimers()
+      }
+    })
+
+    it('plays one water splash per tool.start', () => {
+      const onEvent = createGatewayEventHandler(buildCtx([]))
+      const before = $wavePulse.get()
+
+      onEvent({ payload: { name: 'terminal', tool_id: 't1' }, type: 'tool.start' } as any)
+      onEvent({ payload: { name: 'read_file', tool_id: 't2' }, type: 'tool.start' } as any)
+
+      expect($wavePulse.get()).toBe(before + 2)
+    })
+  })
 })

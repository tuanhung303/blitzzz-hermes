diff --git a/tools/runtime_budget.py b/tools/runtime_budget.py
new file mode 100644
index 0000000000..6c61185493
--- /dev/null
+++ b/tools/runtime_budget.py
@@ -0,0 +1,68 @@
+"""Runtime-budget classifications shared by terminal and process tools.
+
+The terminal surface returns one concise advisory for the observed runtime
+instead of repeating the whole policy table in every tool result. Background
+process reads additionally report whether any output has been observed, which
+lets the agent distinguish productive batch work from a silent possible stall.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+
+RUNTIME_ADVICES: tuple[str, ...] = (
+    "<1 min: Healthy — continue normally.",
+    "1–3 min: Acceptable — continue, but monitor runtime.",
+    "3–10 min: Next iteration, consider reducing scope, sampling, or optimizing.",
+    "10–30 min: Next iteration, avoid repeating this approach; verify a faster alternative first.",
+    ">30 min: Do not repeat interactively; redesign the approach or use a batch job.",
+)
+
+
+def runtime_advice_for_seconds(elapsed_seconds: float) -> str:
+    """Return the advisory bucket for a non-negative observed runtime."""
+    elapsed = max(0.0, float(elapsed_seconds))
+    if elapsed < 60:
+        return RUNTIME_ADVICES[0]
+    if elapsed < 180:
+        return RUNTIME_ADVICES[1]
+    if elapsed < 600:
+        return RUNTIME_ADVICES[2]
+    if elapsed < 1800:
+        return RUNTIME_ADVICES[3]
+    return RUNTIME_ADVICES[4]
+
+
+def runtime_metadata(
+    elapsed_seconds: float,
+    *,
+    progress_observed: Optional[bool] = None,
+) -> dict:
+    """Build low-noise runtime metadata for a terminal/process response.
+
+    ``progress_observed`` is omitted for synchronous terminal results because
+    their output only becomes visible when the command returns. Background
+    process reads pass a real output-observed signal.
+    """
+    elapsed = max(0.0, float(elapsed_seconds))
+    metadata = {
+        "runtime_seconds": round(elapsed, 2),
+        "runtime_advice": runtime_advice_for_seconds(elapsed),
+    }
+    if progress_observed is None:
+        return metadata
+
+    metadata["progress_observed"] = bool(progress_observed)
+    if elapsed >= 180:
+        if progress_observed:
+            metadata["progress_advice"] = (
+                "Observable output exists; this can remain an explicit batch job, "
+                "but continue monitoring runtime and progress."
+            )
+        else:
+            metadata["progress_advice"] = (
+                "No output has been observed; treat this as a possible stall and "
+                "stop it safely if practical before redesigning the approach."
+            )
+    return metadata

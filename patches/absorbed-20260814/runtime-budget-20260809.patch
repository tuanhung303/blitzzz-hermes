@@ -0,0 +1,57 @@
+"""Terminal integration contracts for execution-budget metadata and caps."""
+
+import json
+from unittest.mock import MagicMock, patch
+
+
+def _env_config(**overrides):
+    config = {
+        "env_type": "local",
+        "timeout": 180,
+        "cwd": "/tmp",
+        "host_cwd": None,
+        "modal_mode": "auto",
+        "docker_image": "",
+        "singularity_image": "",
+        "modal_image": "",
+        "daytona_image": "",
+    }
+    config.update(overrides)
+    return config
+
+
+def _run_with_mock_env(*, config_timeout=180):
+    from tools.terminal_tool import terminal_tool
+
+    env = MagicMock()
+    env.cwd = "/tmp"
+    env.execute.return_value = {"output": "done", "returncode": 0}
+    with (
+        patch("tools.terminal_tool._get_env_config", return_value=_env_config(timeout=config_timeout)),
+        patch("tools.terminal_tool._start_cleanup_thread"),
+        patch("tools.terminal_tool._active_environments", {"default": env}),
+        patch("tools.terminal_tool._last_activity", {"default": 0}),
+        patch("tools.terminal_tool._check_all_guards", return_value={"approved": True}),
+    ):
+        result = json.loads(terminal_tool(command="echo done"))
+    return env, result
+
+
+def test_foreground_terminal_returns_runtime_advice():
+    _env, result = _run_with_mock_env()
+
+    assert result["runtime_seconds"] >= 0
+    assert result["runtime_advice"].startswith("<1 min: Healthy")
+
+
+def test_configured_foreground_timeout_is_safely_clamped_to_ten_minutes():
+    from tools.terminal_tool import FOREGROUND_MAX_TIMEOUT
+
+    env, result = _run_with_mock_env(config_timeout=3600)
+
+    assert result["error"] is None
+    assert env.execute.call_args.kwargs["timeout"] == FOREGROUND_MAX_TIMEOUT
+    assert result["runtime_timeout_note"] == (
+        f"Configured foreground timeout 3600s was clamped to the safe synchronous "
+        f"limit of {FOREGROUND_MAX_TIMEOUT}s."
+    )

@@ -0,0 +1,62 @@
+"""Contracts for interactive execution-budget guidance and runtime advice."""
+
+import time
+
+import pytest
+
+from tools.process_registry import ProcessRegistry, ProcessSession
+from tools.runtime_budget import (
+    RUNTIME_ADVICES,
+    runtime_advice_for_seconds,
+    runtime_metadata,
+)
+
+
+@pytest.mark.parametrize(
+    ("seconds", "expected_index"),
+    [
+        (0, 0),
+        (59.999, 0),
+        (60, 1),
+        (179.999, 1),
+        (180, 2),
+        (599.999, 2),
+        (600, 3),
+        (1799.999, 3),
+        (1800, 4),
+    ],
+)
+def test_runtime_advice_thresholds(seconds, expected_index):
+    assert runtime_advice_for_seconds(seconds) == RUNTIME_ADVICES[expected_index]
+
+
+def test_runtime_metadata_flags_silent_long_work_as_possible_stall():
+    metadata = runtime_metadata(301, progress_observed=False)
+
+    assert metadata["runtime_seconds"] == 301
+    assert metadata["progress_observed"] is False
+    assert "possible stall" in metadata["progress_advice"].lower()
+
+
+def test_runtime_metadata_accepts_observable_batch_progress():
+    metadata = runtime_metadata(901, progress_observed=True)
+
+    assert metadata["progress_observed"] is True
+    assert "continue monitoring" in metadata["progress_advice"].lower()
+
+
+def test_background_poll_returns_runtime_advice_and_progress_signal():
+    registry = ProcessRegistry()
+    session = ProcessSession(
+        id="proc_budget",
+        command="batch-job",
+        started_at=time.time() - 601,
+        output_buffer="step 3 of 10",
+    )
+    registry._running[session.id] = session
+
+    result = registry.poll(session.id)
+
+    assert result["runtime_advice"] == RUNTIME_ADVICES[3]
+    assert result["progress_observed"] is True
+    assert "continue monitoring" in result["progress_advice"].lower()

+def test_format_live_context_does_not_substitute_cumulative_total(monkeypatch):
+    """The /context read-out must not fall back to the lifetime session total
+    when context_used is absent — that substitutes a cumulative number for the
+    current occupancy and reads as an impossible ~1.9M / 272K on long
+    Codex/OAuth sessions (#50421 class)."""
+    session = {
+        "agent": None,
+        "history": [],
+        "session_key": None,
+        "history_lock": threading.Lock(),
+        "_compute_host_active": True,
+        "_metadata_mirror": {
+            "model": "gpt-5.6-sol",
+            "provider": "openai-codex",
+            "usage": {"total": 1_900_000, "context_max": 272_000},
+        },
+        "_metadata_message_count": 0,
+    }
+    monkeypatch.setattr(server, "_get_db", lambda: None)
+    out = server._format_live_context_output(session)
+    # Fail closed: the cumulative total must never surface as current context,
+    # and with occupancy unknown no "Context usage:" line is emitted at all.
+    assert "1,900,000" not in out
+    assert "Context usage" not in out
+

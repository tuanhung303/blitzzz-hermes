+    def test_rejects_interlaced(self):
+        ihdr = struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 1)  # interlace=1
+
+        def chunk(ctype: bytes, payload: bytes) -> bytes:
+            return (
+                struct.pack(">I", len(payload))
+                + ctype
+                + payload
+                + struct.pack(">I", zlib.crc32(ctype + payload) & 0xFFFFFFFF)
+            )
+
+        png = (
+            b"\x89PNG\r\n\x1a\n"
+            + chunk(b"IHDR", ihdr)
+            + chunk(b"IDAT", zlib.compress(b"\x00\xff\x00\x00"))
+            + chunk(b"IEND", b"")
+        )
+        path = "/tmp/test_probe_interlaced.png"
+        with open(path, "wb") as fh:
+            fh.write(png)
+        # Interlaced data decodes to garbage or fails; decode_png must not raise.
+        result = probe.decode_png(path)
+        assert result is None or isinstance(result, list)

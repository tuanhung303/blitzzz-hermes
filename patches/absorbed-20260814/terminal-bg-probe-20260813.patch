new file mode 100644
index 000000000..b5060b76c
--- /dev/null
+++ b/hermes_cli/windowlist.swift
@@ -0,0 +1,23 @@
+// List on-screen windows: owner name, window id, bounds, layer.
+// Used by terminal_bg_probe to find the REAL host window (the terminal app
+// that renders this Hermes session) instead of the frontmost window — a
+// light Warp window behind a dark Orca window must not flip the polarity.
+import CoreGraphics
+import Foundation
+
+let opts: CGWindowListOption = [.optionOnScreenOnly, .excludeDesktopElements]
+guard let list = CGWindowListCopyWindowInfo(opts, kCGNullWindowID) as? [[String: Any]] else {
+    exit(1)
+}
+for w in list {
+    let owner = w[kCGWindowOwnerName as String] as? String ?? ""
+    let num = w[kCGWindowNumber as String] as? Int ?? 0
+    let layer = w[kCGWindowLayer as String] as? Int ?? 0
+    guard layer == 0 else { continue } // only normal windows
+    guard let bounds = w[kCGWindowBounds as String] as? [String: Any] else { continue }
+    let x = bounds["X"] as? Int ?? 0
+    let y = bounds["Y"] as? Int ?? 0
+    let wd = bounds["Width"] as? Int ?? 0
+    let ht = bounds["Height"] as? Int ?? 0
+    print("\(owner)\t\(num)\t\(x)\t\(y)\t\(wd)\t\(ht)")
+}

+"""Unit tests for the on-screen terminal background probe.
+
+The probe measures the frontmost terminal window's real pixels so the TUI can
+pick the right light/dark polarity even when the host swallows OSC 10/11
+replies (Herdr panes).  Pure functions are tested directly; the osascript
+parser is tested with a mocked subprocess; the end-to-end flow is tested with
+mocked steps so no display / permissions are needed in CI.
+"""
+
+import struct
+import zlib
+
+import pytest
+
+from hermes_cli import terminal_bg_probe as probe
+
+
+def _make_png(width: int, height: int, pixels: bytes, color_type: int = 2) -> bytes:
+    """Build a minimal 8-bit non-interlaced PNG (RGB=2, RGBA=6)."""
+    bpp = 3 if color_type == 2 else 4
+    raw = b""
+    stride = width * bpp
+    for y in range(height):
+        raw += b"\x00"  # filter: None
+        raw += pixels[y * stride : (y + 1) * stride]
+
+    def chunk(ctype: bytes, payload: bytes) -> bytes:
+        return (
+            struct.pack(">I", len(payload))
+            + ctype
+            + payload
+            + struct.pack(">I", zlib.crc32(ctype + payload) & 0xFFFFFFFF)
+        )
+
+    ihdr = struct.pack(">IIBBBBB", width, height, 8, color_type, 0, 0, 0)
+    return (
+        b"\x89PNG\r\n\x1a\n"
+        + chunk(b"IHDR", ihdr)
+        + chunk(b"IDAT", zlib.compress(raw))
+        + chunk(b"IEND", b"")
+    )
+
+
+class TestDecodePng:
+    def test_rgb_pixels(self):
+        # 2x2: top-left red, top-right green, bottom-left blue, bottom-right white
+        pixels = bytes(
+            [255, 0, 0, 0, 255, 0, 0, 0, 255, 255, 255, 255]
+        )
+        path = "/tmp/test_probe_rgb.png"
+        with open(path, "wb") as fh:
+            fh.write(_make_png(2, 2, pixels))
+        decoded = probe.decode_png(path)
+        assert decoded == [(255, 0, 0), (0, 255, 0), (0, 0, 255), (255, 255, 255)]
+
+    def test_rgba_alpha_ignored(self):
+        pixels = bytes([10, 20, 30, 99, 40, 50, 60, 199])
+        path = "/tmp/test_probe_rgba.png"
+        with open(path, "wb") as fh:
+            fh.write(_make_png(2, 1, pixels, color_type=6))
+        decoded = probe.decode_png(path)
+        assert decoded == [(10, 20, 30), (40, 50, 60)]
+
+    def test_filter_sub_roundtrip(self):
+        # A Sub-filtered 2x1 RGB row: the FIRST pixel is stored as-is; later
+        # bytes are stored as value - left neighbor.  decode_png must apply
+        # the predictor.
+        width, height = 2, 1
+        pixels = bytes([200, 100, 50, 40, 30, 20])
+        stored = bytes(
+            [
+                pixels[0], pixels[1], pixels[2],
+                (pixels[3] - pixels[0]) % 256,
+                (pixels[4] - pixels[1]) % 256,
+                (pixels[5] - pixels[2]) % 256,
+            ]
+        )
+        raw = b"\x01" + stored  # filter 1 = Sub
+
+        def chunk(ctype: bytes, payload: bytes) -> bytes:
+            return (
+                struct.pack(">I", len(payload))
+                + ctype
+                + payload
+                + struct.pack(">I", zlib.crc32(ctype + payload) & 0xFFFFFFFF)
+            )
+
+        ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
+        png = (
+            b"\x89PNG\r\n\x1a\n"
+            + chunk(b"IHDR", ihdr)
+            + chunk(b"IDAT", zlib.compress(raw))
+            + chunk(b"IEND", b"")
+        )
+        path = "/tmp/test_probe_sub.png"

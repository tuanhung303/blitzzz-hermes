+
+export function startLiveBackgroundProbe(): void {
+  const probeCmd = process.env.HERMES_TUI_PROBE_CMD
+
+  if (liveProbeStarted || !probeCmd) {
+    return
+  }
+
+  liveProbeStarted = true
+
+  const probe = () => {
+    if (process.env.HERMES_TUI_THEME || process.env.HERMES_TUI_LIGHT) {
+      return
+    }
+
+    execFile(probeCmd, { timeout: 10_000 }, (error, stdout) => {
+      if (error) {
+        return
+      }
+
+      const hex = stdout.trim().toLowerCase()
+
+      if (!/^#[0-9a-f]{6}$/.test(hex)) {
+        return
+      }
+
+      if (hex === (process.env.HERMES_TUI_BACKGROUND ?? '').toLowerCase()) {
+        return
+      }
+
+      process.env.HERMES_TUI_BACKGROUND = hex
+      reapplyTheme()
+    })
+  }
+
+  const timer = setInterval(probe, LIVE_PROBE_INTERVAL_MS)
+  timer.unref?.()
+}

+++ b/hermes_cli/terminal_bg_probe.py
@@ -0,0 +1,449 @@
+"""Probe the REAL terminal background color by sampling on-screen pixels.
+
+Why this exists
+---------------
+The Ink TUI asks its host terminal for the true colors via OSC 10/11 queries
+(``syncThemeToTerminalBackground`` in ``ui-tui``).  Some hosts swallow the
+replies: Herdr renders the OSC answer into the pane's scrollback instead of
+forwarding it to the pane's stdin, so the TUI inside a Herdr pane never sees
+the terminal's colors and stays pinned to the stale boot-cache polarity —
+washed-out light text on a light terminal, or a light palette on a dark one,
+and "new sessions don't fix it" because the cache re-seeds itself.
+
+This module measures what is actually on screen instead: it finds the
+frontmost window (osascript / System Events, no extra permission needed),
+captures that region (``screencapture``), downscales it (``sips``) and returns
+the dominant background hex from pure-stdlib PNG decoding.  The TUI launch
+path seeds the result into ``HERMES_TUI_BACKGROUND`` — the same env slot the
+OSC answer would fill — so the first frame is already correct, and explicit
+user pins (``HERMES_TUI_THEME`` / ``HERMES_TUI_LIGHT``) still win.
+
+macOS-only, best-effort, never raises: any failure just returns None and the
+TUI's existing fallback chain (OSC -> boot cache -> macOS appearance) takes
+over unchanged.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+import zlib
+from typing import List, Mapping, Optional, Sequence, Tuple
+
+RGB = Tuple[int, int, int]
+
+# Frontmost windows owned by these apps are candidate terminals.  The probe
+# only measures a terminal window — measuring an IDE/editor window would seed
+# the wrong polarity.  ``screencapture`` needs Screen Recording permission for
+# the invoking app; without it the capture fails and the probe returns None.
+_TERMINAL_NAME_RE = re.compile(
+    r"term|orca|warp|iterm|terminal|kitty|alacritty|wezterm|wez|ghostty|"
+    r"hyper|tabby|konsole|gnome|foot|alacritty|rio|wave|visual|vscode|cursor|"
+    r"zed|tmux|herdr",
+    re.IGNORECASE,
+)
+
+
+def _run(cmd: Sequence[str], timeout: float) -> Optional[str]:
+    """Run a short subprocess, returning stdout text or None on any failure."""
+    try:
+        proc = subprocess.run(
+            cmd,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            check=False,
+        )
+        if proc.returncode != 0:
+            return None
+        return proc.stdout
+    except Exception:
+        return None
+
+
+def frontmost_window_bounds(timeout: float = 2.0) -> Optional[Tuple[int, int, int, int, str]]:
+    """Return (x, y, w, h, app_name) of the frontmost window, or None.
+
+    Uses System Events (osascript), which reports window position/size without
+    Screen Recording permission.  Only windows of terminal-like apps are
+    returned, so a launch from an IDE does not pollute the measurement.
+    """
+    script = (
+        'tell application "System Events" to tell (first application process '
+        'whose frontmost is true) to get {name, position of front window, '
+        "size of front window}"
+    )
+    out = _run(["osascript", "-e", script], timeout)
+    if not out:
+        return None
+
+    # AppleScript list: `Name, x, y, w, h` — quoted when the name has spaces.
+    parts = [p.strip() for p in out.split(",")]
+    if len(parts) != 5:
+        return None
+    name = parts[0].strip('"')
+    try:
+        x, y, w, h = (int(parts[i]) for i in range(1, 5))
+    except ValueError:
+        return None
+    if w <= 0 or h <= 0:
+        return None
+    if not _TERMINAL_NAME_RE.search(name):
+        return None
+    return (x, y, w, h, name)
+
+
+# TERM_PROGRAM values map to the CGWindow owner name of the app that RENDERS
+# this session.  Measuring that window — not the frontmost one — is what keeps
+# a light Warp window behind a dark Orca window from flipping the polarity.
+_TERM_PROGRAM_HOST_APP = {
+    "WarpTerminal": "Warp",
+    "Orca": "Orca",
+    "iTerm.app": "iTerm2",
+    "Apple_Terminal": "Terminal",
+    "WezTerm": "WezTerm",
+    "ghostty": "ghostty",
+    "Alacritty": "Alacritty",
+    "kitty": "kitty",
+    "vscode": "Code",
+    "cursor": "Cursor",
+    "zed": "Zed",
+}
+
+
+def host_app_from_env(env: Optional[Mapping[str, str]] = None) -> Optional[str]:
+    """Return the CGWindow owner name of the terminal hosting this session.
+
+    Derived from TERM_PROGRAM (the outer terminal that spawned our process
+    tree).  When TERM_PROGRAM names an editor (vscode/cursor) or is unknown,
+    the probe falls back to the frontmost-window heuristic.
+    """
+    env = os.environ if env is None else env
+    term_program = (env.get("TERM_PROGRAM") or "").strip()
+    return _TERM_PROGRAM_HOST_APP.get(term_program)
+
+
+_WINDOWLIST_SWIFT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "windowlist.swift")
+_WINDOWLIST_BIN = os.path.join(
+    tempfile.gettempdir(), "hermes-windowlist-bin"
+)
+
+
+def _ensure_windowlist_binary(timeout: float = 20.0) -> Optional[str]:
+    """Compile windowlist.swift once (cache by source mtime), return bin path."""
+    if not os.path.exists(_WINDOWLIST_SWIFT):
+        return None
+    try:
+        src_mtime = os.path.getmtime(_WINDOWLIST_SWIFT)
+    except OSError:
+        return None
+    if os.path.exists(_WINDOWLIST_BIN):
+        try:
+            if os.path.getmtime(_WINDOWLIST_BIN) >= src_mtime:
+                return _WINDOWLIST_BIN
+        except OSError:
+            pass
+    if _run(["xcrun", "--find", "swiftc"], timeout=5.0) is None:
+        return None
+    out = _run(
+        ["swiftc", "-O", _WINDOWLIST_SWIFT, "-o", _WINDOWLIST_BIN],
+        timeout=timeout,
+    )
+    if out is None or not os.path.exists(_WINDOWLIST_BIN):
+        return None
+    return _WINDOWLIST_BIN
+
+
+def host_window_bounds(timeout: float = 3.0) -> Optional[Tuple[int, int, int, int, str, int]]:
+    """Return (x, y, w, h, app_name, window_id) of the host terminal's window.
+
+    Uses CGWindowList (via a tiny swift helper) so the window is found even
+    when it is NOT frontmost — e.g. a light Warp window behind a dark Orca
+    window.  Window id lets `screencapture -l` capture the window's own
+    content even when it is partially occluded.  Returns None when the host
+    app is unknown or no on-screen window exists for it.
+    """
+    app = host_app_from_env()
+    if not app:
+        return None
+    binary = _ensure_windowlist_binary(timeout=min(20.0, max(5.0, timeout + 5)))
+    if not binary:
+        return None
+    out = _run([binary], timeout=min(2.0, timeout))
+    if not out:
+        return None
+    best = None
+    for line in out.splitlines():
+        parts = line.split("\t")
+        if len(parts) != 6:
+            continue
+        owner, wid_s, x_s, y_s, w_s, h_s = parts
+        try:
+            wid, x, y, w, h = int(wid_s), int(x_s), int(y_s), int(w_s), int(h_s)
+        except ValueError:
+            continue
+        if owner != app or w <= 0 or h <= 0:
+            continue
+        area = w * h
+        if best is None or area > best[0]:
+            best = (area, x, y, w, h, wid)
+    if best is None:
+        return None
+    _, x, y, w, h, wid = best
+    return (x, y, w, h, app, wid)
+
+
+def capture_window(window_id: int, timeout: float = 2.0) -> Optional[str]:
+    """Capture a specific window's content (even when occluded) to a temp PNG."""
+    fd, path = tempfile.mkstemp(prefix="hermes-bg-probe-", suffix=".png")
+    os.close(fd)
+    try:
+        out = _run(["screencapture", "-x", "-l", str(window_id), path], timeout)
+        if out is None or not os.path.getsize(path):
+            return None
+        return path
+    except Exception:
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
+        return None
+
+
+def capture_region(
+    x: int, y: int, w: int, h: int, timeout: float = 2.0
+) -> Optional[str]:
+    """Capture the given screen region to a temp PNG, returning its path."""
+    x = max(x, 0)
+    y = max(y, 0)
+    fd, path = tempfile.mkstemp(prefix="hermes-bg-probe-", suffix=".png")
+    os.close(fd)
+    try:
+        out = _run(
+            ["screencapture", "-x", "-R", f"{x},{y},{w},{h}", path],
+            timeout,
+        )
+        if out is None or not os.path.getsize(path):
+            return None
+        return path
+    except Exception:
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
+        return None
+
+
+def downscale(path: str, size: int = 8, timeout: float = 2.0) -> Optional[str]:
+    """Downscale a PNG to `size`x`size` via sips; returns the new temp path."""
+    fd, small = tempfile.mkstemp(prefix="hermes-bg-probe-small-", suffix=".png")
+    os.close(fd)
+    try:
+        out = _run(
+            ["sips", "-z", str(size), str(size), path, "--out", small],
+            timeout,
+        )
+        if out is None or not os.path.getsize(small):
+            return None
+        return small
+    except Exception:
+        try:
+            os.unlink(small)
+        except OSError:
+            pass
+        return None
+
+
+def decode_png(path: str) -> Optional[List[RGB]]:
+    """Decode a small 8-bit RGB/RGBA non-interlaced PNG into pixels.
+
+    Pure stdlib (zlib + struct) so the probe needs no dependencies.  Returns
+    None for anything unsupported (16-bit, palette, interlaced).
+    """
+    try:
+        with open(path, "rb") as fh:
+            data = fh.read()
+    except OSError:
+        return None
+    if data[:8] != b"\x89PNG\r\n\x1a\n":
+        return None
+
+    pos = 8
+    idat = b""
+    width = height = bitdepth = colortype = None
+    while pos < len(data):
+        if pos + 8 > len(data):
+            return None
+        (length,), ctype = struct.unpack(">I", data[pos : pos + 4]), data[pos + 4 : pos + 8]
+        pos += 8
+        chunk = data[pos : pos + length]
+        pos += length + 4
+        if ctype == b"IHDR":
+            if length < 13:
+                return None
+            width, height, bitdepth, colortype = struct.unpack(">IIBB", chunk[:10])
+        elif ctype == b"IDAT":
+            idat += chunk
+        elif ctype == b"IEND":
+            break
+
+    if width is None or height is None or bitdepth != 8 or colortype not in (2, 6):
+        return None
+    bpp = 3 if colortype == 2 else 4
+    try:
+        raw = zlib.decompress(idat)
+    except zlib.error:
+        return None
+
+    stride = width * bpp
+    expected = (stride + 1) * height
+    if len(raw) < expected:
+        return None
+    raw = raw[:expected]
+
+    out = bytearray()
+    prev = bytearray(stride)
+    pos = 0
+    for _ in range(height):
+        f = raw[pos]
+        pos += 1
+        line = bytearray(raw[pos : pos + stride])
+        pos += stride
+        if f == 0:  # None
+            pass
+        elif f == 1:  # Sub
+            for i in range(bpp, stride):
+                line[i] = (line[i] + line[i - bpp]) % 256
+        elif f == 2:  # Up
+            for i in range(stride):
+                line[i] = (line[i] + prev[i]) % 256
+        elif f == 3:  # Average
+            for i in range(stride):
+                a = line[i - bpp] if i >= bpp else 0
+                line[i] = (line[i] + ((a + prev[i]) >> 1)) % 256
+        elif f == 4:  # Paeth
+            for i in range(stride):
+                a = line[i - bpp] if i >= bpp else 0
+                b = prev[i]
+                c = prev[i - bpp] if i >= bpp else 0
+                p = a + b - c
+                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
+                if pa <= pb and pa <= pc:
+                    pr = a
+                elif pb <= pc:
+                    pr = b
+                else:
+                    pr = c
+                line[i] = (line[i] + pr) % 256
+        else:
+            return None
+        out += line
+        prev = line
+
+    pixels: List[RGB] = []
+    for y in range(height):
+        row = out[y * stride : (y + 1) * stride]
+        for x in range(width):
+            o = x * bpp
+            pixels.append((row[o], row[o + 1], row[o + 2]))
+    return pixels
+
+
+def median_color(pixels: Sequence[RGB]) -> Optional[RGB]:
+    """Dominant color via per-channel median (text pixels are the minority)."""
+    if not pixels:
+        return None
+    return tuple(sorted(c[i] for c in pixels)[len(pixels) // 2] for i in range(3))  # type: ignore[return-value]
+
+
+def to_hex(rgb: RGB) -> str:
+    return "#%02x%02x%02x" % rgb
+
+
+def probe_terminal_background(timeout: float = 3.0) -> Optional[str]:
+    """Measure the REAL terminal background as '#rrggbb'.
+
+    Resolution order:
+      1. The HOST window — the terminal app that renders this session
+         (from TERM_PROGRAM), found via CGWindowList and captured by window id
+         so occlusion by other apps doesn't pollute the measurement.
+      2. The frontmost window (legacy heuristic), when TERM_PROGRAM doesn't
+         name a known host app.
+
+    Returns None when the platform is not macOS, no terminal window can be
+    found, or any step fails — callers should treat None as \"no answer\" and
+    keep their existing fallback chain.
+    """
+    if sys.platform != "darwin":
+        return None
+
+    deadline = time.monotonic() + timeout
+
+    # 1) Host window first: correct even when another app is frontmost.
+    host = host_window_bounds(timeout=min(2.0, timeout))
+    if host:
+        x, y, w, h, _app, wid = host
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            return None
+        region = capture_window(wid, timeout=min(2.0, remaining))
+        if region:
+            hex_color = _finish_probe(region, deadline)
+            if hex_color:
+                return hex_color
+
+    # 2) Fallback: frontmost terminal window (legacy behavior).
+    bounds = frontmost_window_bounds(timeout=min(2.0, timeout))
+    if not bounds:
+        return None
+    x, y, w, h, _name = bounds
+
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        return None
+    region = capture_region(x, y, w, h, timeout=min(2.0, remaining))
+    if not region:
+        return None
+    return _finish_probe(region, deadline)
+
+
+def _finish_probe(region: str, deadline: float) -> Optional[str]:
+    """Downscale, decode, median — shared tail of both probe paths."""
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        try:
+            os.unlink(region)
+        except OSError:
+            pass
+        return None
+    small = downscale(region, size=8, timeout=min(2.0, remaining))
+    if not small:
+        try:
+            os.unlink(region)
+        except OSError:
+            pass
+        return None
+
+    pixels = decode_png(small)
+    # Decode first, THEN clean up — decode_png needs the file on disk.
+    for path in (region, small):
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
+    if not pixels:
+        return None
+    med = median_color(pixels)
+    if med is None:
+        return None
+    return to_hex(med)
+
+
+if __name__ == "__main__":
+    hex_color = probe_terminal_background()
+    print(hex_color or "no-answer")
